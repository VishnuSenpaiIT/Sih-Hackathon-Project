{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TrafficDetectionEvent",
  "description": "Standardized data contract emitted by CV/Edge and consumed by Backend and Frontend WebSocket.",
  "type": "object",
  "properties": {
    "camera_id": {
      "type": "string",
      "description": "Unique identifier for the camera source"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp of frame capture/processing"
    },
    "frame_id": {
      "type": "integer",
      "minimum": 0,
      "description": "Sequential frame index within the stream session"
    },
    "vehicle_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Total count of motorized vehicles (car + bus + truck + bike)"
    },
    "class_counts": {
      "type": "object",
      "properties": {
        "car": { "type": "integer", "minimum": 0 },
        "bus": { "type": "integer", "minimum": 0 },
        "truck": { "type": "integer", "minimum": 0 },
        "bike": { "type": "integer", "minimum": 0 },
        "pedestrian": { "type": "integer", "minimum": 0 }
      },
      "required": ["car", "bus", "truck", "bike", "pedestrian"],
      "additionalProperties": false
    },
    "density": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 100.0,
      "description": "Computed congestion index on a 0-100 scale"
    },
    "queue_length": {
      "type": "number",
      "minimum": 0.0,
      "description": "Estimated queue length in meters or vehicle units"
    },
    "detections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "track_id": {
            "type": ["integer", "null"],
            "description": "Unique tracker ID across frames, or null if tracker unassigned"
          },
          "class": {
            "type": "string",
            "enum": ["car", "bus", "truck", "bike", "pedestrian"]
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "bbox": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 4,
            "maxItems": 4,
            "description": "[x1, y1, x2, y2] bounding box coordinates"
          }
        },
        "required": ["class", "confidence", "bbox"],
        "additionalProperties": false
      }
    },
    "processing_time_ms": {
      "type": "number",
      "minimum": 0.0,
      "description": "Inference and processing latency in milliseconds"
    }
  },
  "required": [
    "camera_id",
    "timestamp",
    "vehicle_count",
    "class_counts",
    "density",
    "detections"
  ],
  "additionalProperties": false
}
